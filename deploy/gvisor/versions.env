# This file is intentionally committed. Updating either artifact is a reviewed
# supply-chain change: update the URL and checksum together, then rerun the
# smoke test on every supported architecture.

# gVisor release artifact for Linux arm64, recorded 2026-09-22.
# The URL is a release-channel alias, but provisioning verifies this exact
# checksum before installation and fails if the alias moves.
GVISOR_TARBALL_URL=https://storage.googleapis.com/gvisor/releases/release/latest/aarch64/gvisor.tar.zstd
GVISOR_TARBALL_SHA512=c3f556ea8dd122c99bedffb994801b585d7314ab549a98c295a5f15069d9eacd44fd241f562fa3b10f6a5d82a71cc676e4aa3df8e7016cb0599471f69e236357

# Pin multi-architecture OCI indexes. Docker resolves the Linux/arm64 child
# manifest when these images are built in the Lima VM.
AGENT_NODE_IMAGE=node:22-bookworm-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9
CODEX_VERSION=0.155.1
