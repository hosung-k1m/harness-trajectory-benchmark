# This file is intentionally committed. Updating either artifact is a reviewed
# supply-chain change: update the URL and checksum together, then rerun the
# smoke test on every supported architecture.

# gVisor release artifact for Linux arm64, recorded 2026-09-22. The URL is a
# date-pinned release rather than a moving channel alias.
GVISOR_RELEASE_VERSION=release-20260914.0
GVISOR_TARBALL_URL=https://storage.googleapis.com/gvisor/releases/release/20260914/aarch64/gvisor.tar.zstd
GVISOR_TARBALL_SHA512=c3f556ea8dd122c99bedffb994801b585d7314ab549a98c295a5f15069d9eacd44fd241f562fa3b10f6a5d82a71cc676e4aa3df8e7016cb0599471f69e236357

# Build the C++ SecCheck collector out of tree from the exact source commit
# behind GVISOR_RELEASE_VERSION. The annotated release tag is checked after
# checkout, so a changed tag or a source/version mismatch stops provisioning.
GVISOR_SOURCE_URL=https://github.com/google/gvisor.git
GVISOR_SOURCE_TAG=release-20260914.0
GVISOR_SOURCE_COMMIT=95eb5d5930b0e7736826cc2cb949ba9d2c4d5d29
SECCHECK_PATCH_SHA256=05879dbcb6c6e62e7bbbbbc53bd6846d5907b068d93ba997f5f8186b61c0e6b1
SECCHECK_BAZEL_VERSION=8.3.1
SECCHECK_BAZEL_URL=https://releases.bazel.build/8.3.1/release/bazel-8.3.1-linux-arm64
SECCHECK_BAZEL_SHA256=52bb74f0880ee87b17e3a1aa41257d0dba9e9cb92df4e83f8f6c656a46df152d

# Pin multi-architecture OCI indexes. Docker resolves the Linux/arm64 child
# manifest when these images are built in the Lima VM.
AGENT_NODE_IMAGE=node:22-bookworm-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9
CODEX_VERSION=0.155.1
MITMPROXY_IMAGE=mitmproxy/mitmproxy:12.2.3@sha256:62d266a86ee95187217866c0e35487837498daa3aa1cdce37d256f07e198a47b
