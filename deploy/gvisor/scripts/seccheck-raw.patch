+struct Capture {
+  int fd;
+  std::string id;
+  uint64_t frames = 0;
+  uint64_t oversize = 0;
+  uint32_t reported_drops = 0;
+};
+
+std::string capture_dir;
+std::unordered_map<int, Capture> captures;
+
+bool WriteAll(int fd, const void* data, size_t size) {
+  const auto* bytes = static_cast<const char*>(data);
+  while (size != 0) {
+    const ssize_t n = write(fd, bytes, size);
+    if (n < 0 && errno == EINTR) {
+      continue;
+    }
+    if (n <= 0) {
+      return false;
+    }
+    bytes += n;
+    size -= n;
+  }
+  return true;
+}
+
+void FinishCapture(int client) {
+  const auto it = captures.find(client);
+  if (it == captures.end()) {
+    return;
+  }
+  Capture& capture = it->second;
+  const bool synced = fsync(capture.fd) == 0;
+  close(capture.fd);
+  if (synced) {
+    const std::string path = capture_dir + "/" + capture.id + ".done";
+    const int fd = open(path.c_str(), O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600);
+    if (fd >= 0) {
+      const std::string status = "{\"frames\":" + std::to_string(capture.frames) +
+          ",\"oversize\":" + std::to_string(capture.oversize) +
+          ",\"reportedDrops\":" + std::to_string(capture.reported_drops) + "}\n";
+      if (!WriteAll(fd, status.data(), status.size()) || fsync(fd) != 0) {
+        fprintf(stderr, "seccheck status write failed for %s\n", capture.id.c_str());
+      }
+      close(fd);
+    }
+  }
+  captures.erase(it);
+}
